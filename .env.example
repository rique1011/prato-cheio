# Copie este arquivo para .env (que NÃO vai para o Git) e troque SUA_SENHA.
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO

# Banco de desenvolvimento: usado por `npm start` e `npm run db:migrar`
DATABASE_URL=postgres://pratocheio:SUA_SENHA@localhost:5432/pratocheio

# Banco isolado de testes: usado por `npm test`. Os dados dele são APAGADOS a cada teste.
DATABASE_URL_TESTE=postgres://pratocheio:SUA_SENHA@localhost:5432/pratocheio_teste

# PORT=3000
